+
+export type SettlementCategory =
+  | "city-over-100k"
+  | "city-under-100k"
+  | "town-under-50k";
+
+export const TABLE_3_WATER_USE: Record<
+  SettlementCategory,
+  { label: string; lps: Record<WaterUseHorizon, number>; coverage: Record<WaterUseHorizon, string>; row: Record<WaterUseHorizon, string> }
+> = {
