+    pTotal: c(t.phosphatesP2O5) * P2O5_TO_P,
+    p2o5: c(t.phosphatesP2O5),
+    chlorides: c(t.chlorides),
+    sulfates: c(t.sulfates),
+    surfactants: c(t.surfactants),
+    fats: c(t.fats),
+    oilProducts: c(t.oilProducts),
